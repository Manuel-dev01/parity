# --- Reference prices ---------------------------------------------------------
# Pyth Hermes requires a key since 2026-08-26. Free trial at https://pythdata.app/signup
# Without it Parity falls back to Jupiter's stock reference + Backpack perp marks.
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes

# --- Solana -------------------------------------------------------------------
# Any mainnet RPC. Helius / Triton / QuickNode free tiers all work.
# Server-only on purpose: the URL usually embeds an API key, so it must NOT be NEXT_PUBLIC_.
SOLANA_RPC=https://api.mainnet-beta.solana.com

# --- Jupiter (optional) --------------------------------------------------------
# lite-api.jup.ag is keyless but rate-limited; a free key from https://portal.jup.ag
# switches the app to api.jup.ag.
JUPITER_API_KEY=

# --- Execution -----------------------------------------------------------------
# fair_fill_guard program id once deployed (docs/PROGRAM.md). The program is unaudited, so it
# lives on devnet: NEXT_PUBLIC_GUARD_CLUSTER=devnet means mainnet buys never call it and instead
# use Jupiter's audited programs plus the pre-sign fair-value check. Set it to `mainnet` only
# after an audit and a mainnet deploy.
NEXT_PUBLIC_GUARD_PROGRAM_ID=
NEXT_PUBLIC_GUARD_CLUSTER=devnet
DEVNET_RPC=https://api.devnet.solana.com
# Throwaway keypairs for the scripts only. Never commit; .env is gitignored.
# DEMO_WALLET_SECRET_KEY: mainnet, holds the small real balance for scripts/test-swap.mjs
# DEVNET_SECRET_KEY: devnet, airdrop-funded, used by scripts/guard-proof.mjs
DEMO_WALLET_SECRET_KEY=
DEVNET_SECRET_KEY=

# --- Divergence tape history (optional) -------------------------------------------
# Neon Postgres connection string (Vercel Marketplace -> Neon). Without it the tape shows live data only.
DATABASE_URL=
# Protects /api/cron/snapshot; Vercel sets the matching Authorization header automatically.
CRON_SECRET=
